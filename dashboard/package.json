{
	"name": "dashboard",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"dependencies": {
		"@lucide/svelte": "1.63.0"
	}
}
