{
  "name": "phantom",
  "description": "API mocker and traffic inspector with a built-in dashboard.",
  "private": true,
  "author": "James Doyle",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "build": "pnpm --filter ./dashboard build && pnpm --filter ./server build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter ./server test"
  }
}
