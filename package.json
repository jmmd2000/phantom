{
  "name": "phantom",
  "description": "API mocker and traffic inspector with a built-in dashboard.",
  "private": true,
  "author": "James Doyle",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "build": "pnpm --filter ./dashboard build && pnpm --filter ./server build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check . && eslint .",
    "typecheck": "pnpm --recursive typecheck",
    "test:unit": "vitest run --project server-unit",
    "test:integration": "vitest run --project server-integration",
    "test": "pnpm test:unit && pnpm test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
