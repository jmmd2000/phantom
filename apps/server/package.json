{
  "name": "@jamesmddoyle/phantom",
  "version": "0.3.0",
  "description": "API mocker and traffic inspector with a built-in dashboard.",
  "author": "James Doyle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmmd2000/phantom.git",
    "directory": "apps/server"
  },
  "bin": {
    "phantom": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r ../dashboard/build ./dist/dashboard-ui",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@phantom/shared": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "cac": "7.1.0"
  }
}
